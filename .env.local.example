# Copy to .env.local and fill in. .env.local is gitignored.
#
# Without these two NEXT_PUBLIC_ values the app still runs: it falls back to
# local-only mode, where a number is a label again and nothing is saved online.
# That is the same behaviour a dead network gets, on purpose.

# Project URL and publishable (anon) key. Dashboard: Project Settings > API Keys.
# Both are safe in the browser - row level security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://agyxgjrodidtcybgvywu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Where the app is served from. Only used to build the link that
# scripts/invite.mjs prints, so it has to be the address you send people.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Service role key. Bypasses row level security completely.
#
# Used ONLY by scripts/invite.mjs, which runs on your machine. It has no
# NEXT_PUBLIC_ prefix, so Next.js never puts it in the browser bundle - keep it
# that way, and never commit it.
SUPABASE_SERVICE_ROLE_KEY=
