# Copy to .env.local and fill in. .env.local is gitignored.
#
# Without the two NEXT_PUBLIC_ values the app still runs: it falls back to
# local-only mode, where a number is a label again and nothing is saved online.
# That is the same behaviour a dead network gets, on purpose.

# Project URL and publishable (anon) key. Dashboard: Project Settings > API Keys.
# Both are safe in the browser - row level security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://agyxgjrodidtcybgvywu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Where the app is served from. Used to build the invite links that
# scripts/invite.mjs prints, so it has to be the address you send people.
# On Vercel this must be your real domain, not localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Service role key. Bypasses row level security completely.
#
# Used by scripts/invite.mjs and by the /api/admin routes behind the admin
# panel - both server side. It has no NEXT_PUBLIC_ prefix, so Next.js never
# puts it in the browser bundle. Keep it that way, and never commit it.
#
# Without it the app still works; only the admin panel and the invite script
# stop, and the panel says so rather than failing silently.
SUPABASE_SERVICE_ROLE_KEY=
